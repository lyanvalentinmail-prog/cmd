-- Comando sin argumentos: heal
RegisterCommand("heal", "Restaura toda la vida", false, function()
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.Health = char.Humanoid.MaxHealth
        return "✓ Vida restaurada"
    end
    return "✗ Personaje no encontrado"
end)

-- Comando con argumento: fly (velocidad opcional)
RegisterCommand("fly", "Vuelo (velocidad)", true, function(args)
    local arg = tonumber(args)
    local speed = arg and arg or 50
    -- Simulación simple de vuelo (requiere BodyVelocity)
    local char = player.Character
    if not char then return "✗ Sin personaje" end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return "✗ Root no encontrado" end
    
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1, 1, 1) * 1e5
    bv.Velocity = Vector3.new(0, speed, 0)
    bv.Parent = root
    
    -- Auto-destruir en 0.2 segundos (efecto impulso)
    task.delay(0.2, function() bv:Destroy() end)
    return "✈ Volando! Velocidad: " .. speed
end)

-- Comando con argumento: jumppower
RegisterCommand("jumppower", "Cambia fuerza de salto", true, function(args)
    local power = tonumber(args)
    if not power then return "✗ Especifica un número" end
    local char = player.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.JumpPower = power
        return "✓ JumpPower = " .. power
    end
    return "✗ Error al aplicar"
end)

-- Comando para mostrar mensaje
RegisterCommand("say", "Envía un mensaje al chat", true, function(args)
    if args and args ~= "" then
        game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents") 
            and require(game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest):FireServer(args, "All")
        return "📢 Mensaje enviado: " .. args
    end
    return "✗ Escribe algo después de /say"
end)

