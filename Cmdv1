-- ================================
--       REGISTRO DE COMANDOS
-- ================================
local commands = {}  -- [nombre] = {desc, args, func}

local function RegisterCommand(name, description, hasArgs, func)
    commands[name:lower()] = {
        name = name,
        desc = description,
        hasArgs = hasArgs,
        func = func
    }
    return true
end

