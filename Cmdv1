-- Función para refrescar la lista según búsqueda
local function RefreshCommandList(filterText)
    for _, child in ipairs(listContainer:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local filter = filterText and filterText:lower() or ""
    local yOffset = 0
    for _, cmd in pairs(commands) do
        if filter == "" or cmd.name:lower():find(filter) or cmd.desc:lower():find(filter) then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, config.listItemHeight)
            btn.BackgroundColor3 = Color3.fromRGB(40, 40, 45)
            btn.Text = ""
            btn.BorderSizePixel = 0
            btn.Parent = listContainer
            
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(0, 120, 1, 0)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = cmd.name
            nameLabel.TextColor3 = config.accentColor
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 16
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Position = UDim2.new(0, 8, 0, 0)
            nameLabel.Parent = btn
            
            local argsIcon = (cmd.hasArgs and "⚙" or "◉")
            local argsLabel = Instance.new("TextLabel")
            argsLabel.Size = UDim2.new(0, 40, 1, 0)
            argsLabel.Position = UDim2.new(1, -48, 0, 0)
            argsLabel.BackgroundTransparency = 1
            argsLabel.Text = argsIcon
            argsLabel.TextColor3 = cmd.hasArgs and Color3.fromRGB(255, 200, 100) or Color3.fromRGB(100, 200, 100)
            argsLabel.Font = Enum.Font.Gotham
            argsLabel.TextSize = 18
            argsLabel.Parent = btn
            
            local descLabel = Instance.new("TextLabel")
            descLabel.Size = UDim2.new(1, -180, 1, 0)
            descLabel.Position = UDim2.new(0, 130, 0, 0)
            descLabel.BackgroundTransparency = 1
            descLabel.Text = cmd.desc
            descLabel.TextColor3 = Color3.fromRGB(200, 200, 210)
            descLabel.Font = Enum.Font.Gotham
            descLabel.TextSize = 14
            descLabel.TextXAlignment = Enum.TextXAlignment.Left
            descLabel.TextTruncate = Enum.TextTruncate.AtEnd
            descLabel.Parent = btn
            
            -- Al hacer clic en el comando, se escribe en el TextBox
            btn.MouseButton1Click:Connect(function()
                commandInput.Text = cmd.name .. " "
                commandInput.CursorPosition = #commandInput.Text + 1
            end)
            
            yOffset = yOffset + config.listItemHeight + 4
        end
    end
    listContainer.CanvasSize = UDim2.new(0, 0, 0, yOffset - 4)
end

