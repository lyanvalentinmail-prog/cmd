-- ================================
--       EJECUCIÓN DE COMANDOS
-- ================================
local function ExecuteCommand(rawInput)
    if not rawInput or rawInput == "" then return end
    local parts = {}
    for part in rawInput:gmatch("%S+") do
        table.insert(parts, part)
    end
    local cmdName = parts[1] and parts[1]:lower() or ""
    local args = table.concat(parts, " ", 2)
    
    local cmd = commands[cmdName]
    if cmd then
        if cmd.hasArgs and args == "" then
            feedbackLabel.Text = "❗ El comando '" .. cmd.name .. "' requiere argumentos. Ej: " .. cmd.name .. " <valor>"
            return
        end
        local success, result = pcall(cmd.func, args)
        if success then
            feedbackLabel.Text = result or "✓ Comando ejecutado"
        else
            feedbackLabel.Text = "❌ Error: " .. tostring(result)
        end
    else
        feedbackLabel.Text = "❌ Comando desconocido: " .. cmdName
    end
    -- Limpiar mensaje después de 3 segundos
    task.delay(3, function()
        if feedbackLabel.Text ~= "" then
            feedbackLabel.Text = ""
        end
    end)
end

executeBtn.MouseButton1Click:Connect(function()
    ExecuteCommand(commandInput.Text)
    commandInput.Text = ""
end)

commandInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        ExecuteCommand(commandInput.Text)
        commandInput.Text = ""
    end
end)

-- ================================
--          CHAT INTEGRATION
-- ================================
-- Soporta nuevo sistema TextChatService y legacy (por si falla)
local function SetupChatListener()
    -- Intentar con TextChatService (moderno)
    local success, channel = pcall(function()
        return TextChatService.TextChannels.RBXGeneral
    end)
    if success and channel then
        channel.OnMessageAdded:Connect(function(msg)
            if msg.TextSource == player then
                local text = msg.Text
                if text:sub(1, 1) == config.chatPrefix then
                    local cmdText = text:sub(2)
                    ExecuteCommand(cmdText)
                end
            end
        end)
        return true
    end
    -- Fallback: legacy chat mediante Remote (simulado, requiere que el servidor reenvíe)
    -- En una implementación completa se haría con RemoteEvent, pero para demo no es crítico
    warn("Chat legacy no soportado automáticamente. Usa el TextBox de la GUI.")
    return false
end
SetupChatListener()

